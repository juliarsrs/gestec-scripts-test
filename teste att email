try {
    Write-Host ""
    Write-Host "=============================================="
    Write-Host " Instalação de assinatura - Tecnoplanta"
    Write-Host "=============================================="
    Write-Host ""

    # --------------------------------------------------------
    # 1. Identificar usuário, SID e perfil
    # --------------------------------------------------------

    $loggedOnUser = Get-LoggedOnUser
    $nomeUsuario = $loggedOnUser.Split("\")[-1]
    $sid = Get-UserSid -AccountName $loggedOnUser
    $userProfilePath = Get-UserProfilePath -Sid $sid

    Write-Host "Usuário logado: $loggedOnUser"
    Write-Host "SID: $sid"
    Write-Host "Perfil: $userProfilePath"
    Write-Host ""

    # --------------------------------------------------------
    # 2. Fechar o Outlook
    # --------------------------------------------------------

    $outlookProcesses = Get-Process -Name "OUTLOOK" -ErrorAction SilentlyContinue

    if ($outlookProcesses) {
        Write-Host "O Outlook está aberto e será fechado para aplicar a assinatura."

        $outlookProcesses | Stop-Process -Force

        Start-Sleep -Seconds 3

        Write-Host "Outlook fechado."
    }
    else {
        Write-Host "O Outlook já está fechado."
    }

    Write-Host ""

    # --------------------------------------------------------
    # 3. Detectar versões do Office
    # --------------------------------------------------------

    $officeVersions = @(Get-OfficeVersions -Sid $sid)

    Write-Host "Versões do Office que serão configuradas:"
    $officeVersions | ForEach-Object {
        Write-Host " - $_"
    }

    Write-Host ""

    # --------------------------------------------------------
    # 4. Desabilitar assinaturas em roaming
    # --------------------------------------------------------

    Disable-OutlookRoamingSignatures `
        -Sid $sid `
        -OfficeVersions $officeVersions

    Write-Host ""

    # --------------------------------------------------------
    # 5. Baixar CSV
    # --------------------------------------------------------

    if (Test-Path $CsvPath) {
        Remove-Item -Path $CsvPath -Force -ErrorAction SilentlyContinue
    }

    Write-Host "Baixando CSV:"
    Write-Host $CsvUrl

    Invoke-WebRequest `
        -Uri $CsvUrl `
        -OutFile $CsvPath `
        -UseBasicParsing

    if (-not (Test-Path $CsvPath)) {
        throw "O CSV não foi baixado corretamente."
    }

    if ((Get-Item $CsvPath).Length -eq 0) {
        throw "O arquivo CSV foi baixado, mas está vazio."
    }

    Write-Host "CSV baixado em: $CsvPath"
    Write-Host ""

    # --------------------------------------------------------
    # 6. Importar CSV
    # --------------------------------------------------------

    Write-Host "Importando CSV..."

    $rows = @(
        Import-Csv `
            -Path $CsvPath `
            -Encoding UTF8
    )

    if ($rows.Count -eq 0) {
        throw "O CSV está vazio ou possui uma estrutura inválida."
    }

    $requiredColumns = @(
        "ServiceTag",
        "nome",
        "cargo",
        "telefone",
        "endereco",
        "link_logo",
        "link_gif",
        "link_site",
        "link_facebook",
        "link_linkedin",
        "link_telefone"
    )

    $availableColumns = @(
        $rows[0].PSObject.Properties.Name
    )

    foreach ($column in $requiredColumns) {
        if ($column -notin $availableColumns) {
            throw "A coluna obrigatória '$column' não foi encontrada no CSV."
        }
    }

    Write-Host "$($rows.Count) registro(s) importado(s)."
    Write-Host ""

    # --------------------------------------------------------
    # 7. Localizar usuário pelo ServiceTag
    # --------------------------------------------------------

    $serviceTag = (
        Get-CimInstance -ClassName Win32_BIOS
    ).SerialNumber.Trim()

    if ([string]::IsNullOrWhiteSpace($serviceTag)) {
        throw "Não foi possível obter o ServiceTag do computador."
    }

    Write-Host "ServiceTag do computador: '$serviceTag'"

    $matchingRows = @(
        $rows | Where-Object {
            -not [string]::IsNullOrWhiteSpace($_.ServiceTag) -and
            $_.ServiceTag.Trim() -eq $serviceTag
        }
    )

    if ($matchingRows.Count -eq 0) {
        throw "O ServiceTag '$serviceTag' não foi encontrado no CSV."
    }

    if ($matchingRows.Count -gt 1) {
        Write-Warning "Foram encontrados vários registros com o ServiceTag '$serviceTag'. O primeiro será utilizado."
    }

    $userRow = $matchingRows[0]

    if ([string]::IsNullOrWhiteSpace($userRow.nome)) {
        throw "O campo 'nome' está vazio para o ServiceTag '$serviceTag'."
    }

    Write-Host "Registro localizado para: $($userRow.nome)"
    Write-Host ""

    # --------------------------------------------------------
    # 8. Montar HTML da assinatura
    # --------------------------------------------------------

    $htmlBody = $htmlTemplate.
        Replace("{{NOME}}", [string]$userRow.nome).
        Replace("{{CARGO}}", [string]$userRow.cargo).
        Replace("{{TELEFONE}}", [string]$userRow.telefone).
        Replace("{{ENDERECO}}", [string]$userRow.endereco).
        Replace("{{LINK_LOGO}}", [string]$userRow.link_logo).
        Replace("{{LINK_GIF}}", [string]$userRow.link_gif).
        Replace("{{LINK_SITE}}", [string]$userRow.link_site).
        Replace("{{LINK_FACEBOOK}}", [string]$userRow.link_facebook).
        Replace("{{LINK_LINKEDIN}}", [string]$userRow.link_linkedin).
        Replace("{{LINK_TELEFONE}}", [string]$userRow.link_telefone)

    $sigName = ConvertTo-SafeFileName -Name $userRow.nome

    $fullHtml = @"
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="Generator" content="Microsoft Outlook">
<title>$sigName</title>
</head>
<body style="margin:0; padding:0;">
$htmlBody
</body>
</html>
"@

    # --------------------------------------------------------
    # 9. Criar diretório de assinaturas
    # --------------------------------------------------------

    $sigRoot = Join-Path `
        $userProfilePath `
        "AppData\Roaming\Microsoft\Signatures"

    if (-not (Test-Path $sigRoot)) {
        New-Item `
            -Path $sigRoot `
            -ItemType Directory `
            -Force | Out-Null
    }

    $htmPath = Join-Path $sigRoot "$sigName.htm"
    $txtPath = Join-Path $sigRoot "$sigName.txt"
    $rtfPath = Join-Path $sigRoot "$sigName.rtf"

    Write-Host "Diretório das assinaturas:"
    Write-Host $sigRoot
    Write-Host ""

    # --------------------------------------------------------
    # 10. Criar arquivo HTML
    # --------------------------------------------------------

    $utf8Bom = New-Object System.Text.UTF8Encoding($true)

    [System.IO.File]::WriteAllText(
        $htmPath,
        $fullHtml,
        $utf8Bom
    )

    # --------------------------------------------------------
    # 11. Criar arquivo TXT
    # --------------------------------------------------------

    $plainText = @"
$($userRow.nome)
$($userRow.cargo)
$($userRow.endereco)
+$($userRow.telefone)
tecnoplanta.com.br
"@

    [System.IO.File]::WriteAllText(
        $txtPath,
        $plainText.Trim(),
        $utf8Bom
    )

    # --------------------------------------------------------
    # 12. Criar arquivo RTF
    # --------------------------------------------------------

    $rtfNome = ConvertTo-RtfText -Text $userRow.nome
    $rtfCargo = ConvertTo-RtfText -Text $userRow.cargo
    $rtfEndereco = ConvertTo-RtfText -Text $userRow.endereco
    $rtfTelefone = ConvertTo-RtfText -Text $userRow.telefone

    $rtfContent = @"
{\rtf1\ansi\ansicpg1252\deff0
{\fonttbl{\f0\fnil Aptos;}{\f1\fnil Arial;}}
{\colortbl;
\red89\green89\blue89;
\red0\green176\blue80;
\red127\green127\blue127;
}
\viewkind4\uc1
\pard\f0\cf1\b\fs24 $rtfNome\b0\par
\pard\f0\cf2\fs22 $rtfCargo\par
\pard\f0\cf3\fs16 $rtfEndereco\par
\pard\f0\cf3\fs16 +$rtfTelefone\par
\pard\f0\cf3\fs16 tecnoplanta.com.br\par
}
"@

    $asciiEncoding = [System.Text.Encoding]::ASCII

    [System.IO.File]::WriteAllText(
        $rtfPath,
        $rtfContent,
        $asciiEncoding
    )

    # --------------------------------------------------------
    # 13. Configurar assinatura como padrão
    # --------------------------------------------------------

    if ($SetAsDefault) {
        Set-OutlookDefaultSignature `
            -Sid $sid `
            -OfficeVersions $officeVersions `
            -SignatureName $sigName
    }
    else {
        Write-Host "A configuração como assinatura padrão foi ignorada."
    }

    Write-Host ""

    # --------------------------------------------------------
    # 14. Validar arquivos
    # --------------------------------------------------------

    $expectedFiles = @(
        $htmPath,
        $txtPath,
        $rtfPath
    )

    foreach ($file in $expectedFiles) {
        if (-not (Test-Path $file)) {
            throw "O arquivo não foi criado corretamente: $file"
        }

        if ((Get-Item $file).Length -eq 0) {
            throw "O arquivo foi criado, mas está vazio: $file"
        }
    }

    # --------------------------------------------------------
    # 15. Validar registro
    # --------------------------------------------------------

    foreach ($version in $officeVersions) {
        $setupKey = "Registry::HKEY_USERS\$sid\Software\Microsoft\Office\$version\Outlook\Setup"
        $mailSettingsKey = "Registry::HKEY_USERS\$sid\Software\Microsoft\Office\$version\Common\MailSettings"

        $setupValues = Get-ItemProperty -Path $setupKey

        if ($setupValues.DisableRoamingSignatures -ne 1) {
            throw "Não foi possível configurar DisableRoamingSignatures no Office $version."
        }

        if ($SetAsDefault) {
            $mailValues = Get-ItemProperty -Path $mailSettingsKey

            if ($mailValues.NewSignature -ne $sigName) {
                throw "A assinatura padrão para novas mensagens não foi configurada no Office $version."
            }

            if ($mailValues.ReplySignature -ne $sigName) {
                throw "A assinatura padrão para respostas não foi configurada no Office $version."
            }
        }
    }

    # --------------------------------------------------------
    # 16. Remover CSV temporário
    # --------------------------------------------------------

    Remove-Item `
        -Path $CsvPath `
        -Force `
        -ErrorAction SilentlyContinue

    # --------------------------------------------------------
    # Resultado
    # --------------------------------------------------------

    Write-Host ""
    Write-Host "=============================================="
    Write-Host " ASSINATURA CRIADA COM SUCESSO"
    Write-Host "=============================================="
    Write-Host ""
    Write-Host "Assinatura: $sigName"
    Write-Host ""
    Write-Host "Arquivos criados:"
    Write-Host " - $htmPath"
    Write-Host " - $txtPath"
    Write-Host " - $rtfPath"
    Write-Host ""
    Write-Host "Abra novamente o Outlook para carregar a assinatura."
    Write-Host ""
}
catch {
    Write-Host ""
    Write-Host "=============================================="
    Write-Host " ERRO AO CRIAR A ASSINATURA"
    Write-Host "=============================================="
    Write-Host ""

    Write-Error $_.Exception.Message

    if (Test-Path $CsvPath) {
        Remove-Item `
            -Path $CsvPath `
            -Force `
            -ErrorAction SilentlyContinue
    }

    exit 1
}
