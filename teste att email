param(
    [string]$CsvUrl = "https://drive.google.com/uc?export=download&id=1PIbfEFZN6wVIsUmPpTatFXNs3NghzwKq",
    [string]$CsvPath = "$env:TEMP\tecnoplanta-data.csv",
    [switch]$SetAsDefault = $true
)

# Template HTML da assinatura
