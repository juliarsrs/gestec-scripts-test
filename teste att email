function Get-LoggedOnUser {
    $computerSystem = Get-CimInstance -ClassName Win32_ComputerSystem

    if ([string]::IsNullOrWhiteSpace($computerSystem.UserName)) {
        throw "Nenhum usuário logado foi encontrado."
    }

    return $computerSystem.UserName
}

function Get-UserSid {
    param(
        [Parameter(Mandatory)]
        [string]$AccountName
    )

    try {
        $ntAccount = New-Object System.Security.Principal.NTAccount($AccountName)

        return $ntAccount.Translate(
            [System.Security.Principal.SecurityIdentifier]
        ).Value
    }
    catch {
        throw "Não foi possível obter o SID do usuário '$AccountName'. Detalhes: $($_.Exception.Message)"
    }
}

function Get-UserProfilePath {
    param(
        [Parameter(Mandatory)]
        [string]$Sid
    )

    $profileKey = "Registry::HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList\$Sid"

    if (-not (Test-Path $profileKey)) {
        throw "O perfil do usuário não foi localizado no registro. SID: $Sid"
    }

    $profileImagePath = (
        Get-ItemProperty -Path $profileKey -Name "ProfileImagePath"
    ).ProfileImagePath

    $profileImagePath = [Environment]::ExpandEnvironmentVariables(
        $profileImagePath
    )

    if (-not (Test-Path $profileImagePath)) {
        throw "A pasta do perfil não foi encontrada: $profileImagePath"
    }

    return $profileImagePath
}

function ConvertTo-SafeFileName {
    param(
        [Parameter(Mandatory)]
        [string]$Name
    )

    $safeName = $Name.Trim()

    foreach ($invalidCharacter in [System.IO.Path]::GetInvalidFileNameChars()) {
        $safeName = $safeName.Replace(
            [string]$invalidCharacter,
            ""
        )
    }

    if ([string]::IsNullOrWhiteSpace($safeName)) {
        throw "O nome da assinatura ficou vazio após remover caracteres inválidos."
    }

    return $safeName
}

function ConvertTo-RtfText {
    param(
        [AllowNull()]
        [string]$Text
    )

    if ($null -eq $Text) {
        return ""
    }

    $builder = New-Object System.Text.StringBuilder

    foreach ($character in $Text.ToCharArray()) {
        $code = [int][char]$character

        switch ($character) {
            "\" {
                [void]$builder.Append("\\")
            }

            "{" {
                [void]$builder.Append("\{")
            }

            "}" {
                [void]$builder.Append("\}")
            }

            "`r" {
                # Ignorar CR. O LF será tratado abaixo.
            }

            "`n" {
                [void]$builder.Append("\line ")
            }

            default {
                if ($code -gt 127) {
                    if ($code -gt 32767) {
                        $code = $code - 65536
                    }

                    [void]$builder.Append("\u$code?")
                }
                else {
                    [void]$builder.Append($character)
                }
            }
        }
    }

    return $builder.ToString()
}

function Get-OfficeVersions {
    param(
        [Parameter(Mandatory)]
        [string]$Sid
    )

    $possibleVersions = @(
        "16.0",
        "15.0",
        "14.0"
    )

    $detectedVersions = @()

    foreach ($version in $possibleVersions) {
        $officeKey = "Registry::HKEY_USERS\$Sid\Software\Microsoft\Office\$version"

        if (Test-Path $officeKey) {
            $detectedVersions += $version
        }
    }

    # Atualmente o Microsoft 365 e o Outlook 2016/2019/2021 usam 16.0.
    # Caso nenhuma chave tenha sido criada ainda, usamos 16.0.
    if ($detectedVersions.Count -eq 0) {
        $detectedVersions += "16.0"
    }

    return $detectedVersions
}

function Disable-OutlookRoamingSignatures {
    param(
        [Parameter(Mandatory)]
        [string]$Sid,

        [Parameter(Mandatory)]
        [string[]]$OfficeVersions
    )

    foreach ($version in $OfficeVersions) {
        $setupKey = "Registry::HKEY_USERS\$Sid\Software\Microsoft\Office\$version\Outlook\Setup"

        if (-not (Test-Path $setupKey)) {
            New-Item -Path $setupKey -Force | Out-Null
        }

        New-ItemProperty `
            -Path $setupKey `
            -Name "DisableRoamingSignatures" `
            -Value 1 `
            -PropertyType DWord `
            -Force | Out-Null

        # Mantido para compatibilidade com builds que ainda utilizam
        # a configuração temporária.
        New-ItemProperty `
            -Path $setupKey `
            -Name "DisableRoamingSignaturesTemporaryToggle" `
            -Value 1 `
            -PropertyType DWord `
            -Force | Out-Null

        Write-Host "Assinaturas em roaming desabilitadas para o Office $version."
    }
}

function Set-OutlookDefaultSignature {
    param(
        [Parameter(Mandatory)]
        [string]$Sid,

        [Parameter(Mandatory)]
        [string[]]$OfficeVersions,

        [Parameter(Mandatory)]
        [string]$SignatureName
    )

    foreach ($version in $OfficeVersions) {
        $mailSettingsKey = "Registry::HKEY_USERS\$Sid\Software\Microsoft\Office\$version\Common\MailSettings"

        if (-not (Test-Path $mailSettingsKey)) {
            New-Item -Path $mailSettingsKey -Force | Out-Null
        }

        New-ItemProperty `
            -Path $mailSettingsKey `
            -Name "NewSignature" `
            -Value $SignatureName `
            -PropertyType String `
            -Force | Out-Null

        New-ItemProperty `
            -Path $mailSettingsKey `
            -Name "ReplySignature" `
            -Value $SignatureName `
            -PropertyType String `
            -Force | Out-Null

        Write-Host "Assinatura padrão configurada para o Office $version."
    }
}

